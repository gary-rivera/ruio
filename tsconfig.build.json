{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationDir": "dist",
    "emitDeclarationOnly": true, // Only generate .d.ts files
    "baseUrl": ".",
    "rootDir": "./src",
    "paths": {
      "@assets/*": ["src/assets/*"],
      "@components/*": ["src/components/*"],
      "@utils/*": ["src/utils/*"],
      "@constants/*": ["src/constants/*"],
      "@root/*": ["src/*"],
      "@context/*": ["src/context/*"],
      "@controllers/*": ["src/controllers/*"],
      "@hooks/*": ["src/hooks/*"],
      "ruio": ["node_modules/ruio"]
    },
    "outDir": "./dist"
  },
  "include": [
    "src/components/**/*",
    "src/context/**/*",
    "src/controllers/**/*",
    "src/hooks/**/*",
    "src/utils/**/*",
    "src/constants/**/*",
    "src/assets/**/*",
    "src/types/**/*",
    "src/vite-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "test",
    "public",
    "examples",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx"
  ]
}
