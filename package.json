{
  "name": "ruio",
  "version": "1.0.0",
  "type": "module",
  "author": "Gary Rivera <a.gary.rivera@gmail.com> (https://github.com/gary-rivera)",
  "description": "A React developer tool for dynamically applying border styles to elements.",
  "private": false,
  "main": "dist/ruio.cjs.js",
  "module": "dist/ruio.esm.js",
  "types": "dist/components/RuioWrapper.d.ts",
  "exports": {
    ".": {
      "types": "./dist/components/RuioWrapper.d.ts",
      "import": "./dist/ruio.esm.js",
      "require": "./dist/ruio.cjs.js",
      "default": "./dist/ruio.esm.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE",
    "*.css"
  ],
  "scripts": {
    "dev": "vite",
    "type-check": "tsc --noEmit",
    "build": "vite build && tsc --project tsconfig.build.json",
    "lint": "eslint \"**/*.{js,jsx,ts,tsx}\"",
    "lint:fix": "eslint \"**/*.{js,jsx,ts,tsx}\" --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "preview": "vite preview",
    "clean": "rm -rf ./dist node_modules && npm install && npx tsc --build --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run",
    "test:react18": "npm install react@^18.2.0 react-dom@^18.2.0 && npm run test:ci && npm run build",
    "test:react19": "npm install react@^19.0.0 react-dom@^19.0.0 && npm run test:ci && npm run build",
    "prepare": "npm run build",
    "prepublishOnly": "npm run test:ci"
  },
  "keywords": [
    "react",
    "developer-tools",
    "ui",
    "borders",
    "highlight",
    "npm-package",
    "yarn",
    "bun"
  ],
  "license": "MIT",
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/css-modules": "^1.0.5",
    "@types/eslint__js": "^8.42.3",
    "@types/node": "^22.19.0",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "@typescript-eslint/parser": "^8.46.3",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/ui": "^4.0.7",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^15.15.0",
    "jsdom": "^27.1.0",
    "prettier": "^3.6.2",
    "rollup-plugin-postcss": "^4.0.2",
    "ts-node": "^10.9.2",
    "tsc-watch": "^6.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3",
    "vite": "^5.4.21",
    "vite-plugin-checker": "^0.8.0",
    "vite-plugin-css-injected-by-js": "^3.5.2",
    "vite-plugin-svgr": "^4.5.0",
    "vitest": "^4.0.7"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/gary-rivera/ruio.git"
  },
  "bugs": {
    "url": "https://github.com/gary-rivera/ruio/issues"
  },
  "homepage": "https://github.com/gary-rivera/ruio#readme"
}
